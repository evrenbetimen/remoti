{
  "name": "@remoti/desktop",
  "productName": "Remoti",
  "version": "0.1.0",
  "private": true,
  "description": "Remoti desktop shell (Electron + React)",
  "author": "Remoti",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"npm:dev:electron\"",
    "dev:electron": "tsc -p tsconfig.node.json && cross-env REMOTI_DEV_SERVER=http://localhost:5173 electron .",
    "build": "tsc -p tsconfig.node.json && tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "build": {
    "appId": "app.remoti.desktop",
    "directories": {
      "output": "release"
    },
    "artifactName": "Remoti-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "files": [
      "dist-electron/**",
      "dist/renderer/**"
    ],
    "extraResources": [
      {
        "from": "../../target/release/",
        "to": "bin",
        "filter": [
          "remoti-agent",
          "remoti-agent.exe"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Remoti needs screen recording to share this screen with a viewer you approve.",
        "NSAppleEventsUsageDescription": "Remoti needs Accessibility access to apply remote keyboard and mouse input."
      },
      "minimumSystemVersion": "12.3",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
